{
  "name": "ribocode1",
  "version": "0.11.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rm -rf node_modules && npm cache clean --force",
    "preview": "vite preview",
    "start": "vite",
    "dev": "DOTENV_CONFIG_PATH=.env vite",
    "build": "DOTENV_CONFIG_PATH=.env.production vite build && npm run postbuild",
    "postbuild": "cp -r docs dist/docs",
    "serve": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:session": "playwright test e2e/session-load.e2e.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "docs": "typedoc",
    "docs:deploy": "npm run docs && gh-pages -d docs -e docs -a -m \"Docs: update API documentation\"",
    "docs:deploy:dryrun": "npm run docs && gh-pages -d docs -e docs -a --no-push -m \"Docs: update API documentation\"",
    "docs:deploy:target": "npm run docs && node scripts/docs-deploy-target.cjs",
    "docs:deploy:target:dryrun": "npm run docs && node scripts/docs-deploy-target.cjs --dry-run",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "author": "Ribocode Contributors",
  "contributors": [
    "Andy Turner <agdturner@gmail.com>"
  ],
  "license": "MIT",
  "dependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.1.3",
    "gl-matrix": "^3.4.3",
    "lodash": "^4.17.21",
    "postcss": "^8.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rxjs": "^7.8.2",
    "svgo": "^2.8.0",
    "tslib": "^2.8.1",
    "web-vitals": "^5.1.0",
    "workbox-background-sync": "^6.4.2",
    "workbox-broadcast-update": "^6.4.2",
    "workbox-cacheable-response": "^6.4.2",
    "workbox-core": "^6.4.2",
    "workbox-expiration": "^6.4.2",
    "workbox-google-analytics": "^6.4.2",
    "workbox-navigation-preload": "^6.4.2",
    "workbox-precaching": "^6.4.2",
    "workbox-range-requests": "^6.4.2",
    "workbox-routing": "^6.4.2",
    "workbox-strategies": "^6.4.2",
    "workbox-streams": "^6.4.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/big.js": "^6.2.2",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/ui": "^4.1.4",
    "dotenv": "^17.2.3",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.0.2",
    "patch-package": "^8.0.1",
    "playwright": "^1.59.1",
    "typedoc": "^0.28.19",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.4"
  }
}
