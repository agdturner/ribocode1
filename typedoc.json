{
  "tsconfig": "tsconfig.typedoc.json",
  "entryPointStrategy": "expand",
  "entryPoints": ["src"],
  "out": "docs",
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.integration.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**"
  ],
  "includeVersion": true,
  "excludePrivate": true,
  "excludeExternals": true,
  "excludeNotDocumented": false,
  "validation": {
    "notExported": false
  },
  "readme": "README.md",
  "highlightLanguages": [
    "ts",
    "tsx",
    "js",
    "jsx",
    "json",
    "bash",
    "csv"
  ],
  "projectDocuments": [
    "documentation/UserGuide.md",
    "documentation/DeveloperQuickStart.md",
    "documentation/DeveloperGuide.md",
    "documentation/AlignmentDevelopment.md",
    "documentation/AlignmentTesting.md",
    "documentation/CHANGELOG.md",
    "documentation/ROADMAP.md",
    "documentation/decisions/*.md"
  ]
}
